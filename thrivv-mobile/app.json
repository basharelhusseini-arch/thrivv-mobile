{
  "expo": {
    "name": "Thrivv",
    "slug": "thrivv",
    "owner": "thrivv-technologies",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "thrivvmobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0F14",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.thrivv.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Thrivv uses your camera to scan your gym's QR code and verify your workout.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "manifest": {
        "name": "Thrivv",
        "short_name": "Thrivv",
        "description": "Thrivv Mobile App",
        "display": "standalone",
        "orientation": "portrait",
        "theme_color": "#000000",
        "background_color": "#000000",
        "start_url": "/",
        "scope": "/"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F14"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "785c8d66-2994-4969-8df7-e12aec4eb598"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
